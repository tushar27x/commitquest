# /etc/systemd/system/insightshub.service: the Spring Boot backend on the EC2 t3.micro (docs/deploy.md).
# Memory: the JVM flags below peaked at 328 MB RSS through the full-stack e2e suite (2026-11-04),
# leaving room for the OS and Caddy on 1 GB (+ 2 GB swap for the startup spike).
[Unit]
Description=Insight Hub v2 backend
After=network-online.target
Wants=network-online.target

[Service]
User=insightshub
Group=insightshub
# The app reads ./.env (spring.config.import), so the working directory is where .env lives.
WorkingDirectory=/opt/insightshub
Environment=SPRING_PROFILES_ACTIVE=prod
Environment="JAVA_OPTS=-Xms400m -Xmx400m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -XX:MaxDirectMemorySize=64m -Xss512k -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:+ExitOnOutOfMemoryError"
ExecStart=/usr/bin/java $JAVA_OPTS -jar /opt/insightshub/app.jar
# 143 = stopped by SIGTERM (a normal stop or restart), not a failure.
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
TimeoutStopSec=45

# Hardening: the app only reads its jar and .env and logs to the journal; /tmp is private.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
