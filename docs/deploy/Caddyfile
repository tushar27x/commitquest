# /opt/insightshub/Caddyfile (docs/deploy.md): HTTPS in front of the backend. Caddy gets and renews
# the Let's Encrypt certificate itself; ports 80 and 443 must be open in the security group.
# API_DOMAIN comes from deploy.env (e.g. api.example.com or <name>.duckdns.org).
{$API_DOMAIN} {
	encode zstd gzip

	# Only the health check of the actuator is public.
	@actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator 404

	# Caddy replaces any X-Forwarded-For a client sends with the real address. The backend trusts that
	# header only from private addresses (Caddy's, on the compose network), so the per-IP rate limits
	# (login, callback, unsubscribe) see each visitor. No response timeout: the first sync takes ~90 s.
	reverse_proxy backend:8080
}
