# /etc/caddy/Caddyfile: HTTPS in front of the backend (docs/deploy.md). Caddy gets and renews the
# Let's Encrypt certificate itself; ports 80 and 443 must be open in the security group.
# Replace api.example.com with the backend's domain (a DuckDNS name works).
api.example.com {
	encode zstd gzip

	# Only the health check of the actuator is public.
	@actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator 404

	# Caddy replaces any X-Forwarded-For a client sends with the real address; the backend trusts
	# that header from 127.0.0.1 only, so the per-IP rate limits (login, callback, unsubscribe)
	# see each visitor, not Caddy. No response timeout: the first sync can take about 90 s.
	reverse_proxy 127.0.0.1:8080
}
